# flake8: noqa
# pylint: skip-file
# fmt: off

# Configurar variáveis de ambiente (exceto PATH)
import os; gdal = os.path.join("apps", "gdal"); grass = os.path.join("apps", "grass", "grass82"); qgis = os.path.join("apps", "qgis-ltr"); qt = os.path.join("apps", "qt5"); p = os.environ["OSGEO4W_ROOT"] = os.path.normcase(os.path.normpath(os.path.join(os.environ["ProgramFiles"], "QGIS 3.40.12"))); os.environ.update({"GDAL_DATA": os.path.join(p, gdal, "share", "gdal"), "GDAL_DRIVER_PATH": os.path.join(p, gdal, "lib", "gdalplugins"), "GDAL_FILENAME_IS_UTF8": "YES", "GEOTIFF_CSV": os.path.join(p, "share", "epsg_csv"), "GISBASE": os.path.join(p, grass), "GRASS_PROJSHARE": os.path.join(p, "share", "proj"), "GRASS_PYTHON": os.path.join(p, "bin", "python3.exe"), "JPEGMEM": "1000000", "O4W_QT_PREFIX": os.path.join(p, qt), "O4W_QT_BINARIES": os.path.join(p, qt, "bin"), "O4W_QT_HEADERS": os.path.join(p, qt, "include"), "O4W_QT_LIBRARIES": os.path.join(p, qt, "lib"), "O4W_QT_PLUGINS": os.path.join(p, qt, "plugins"), "O4W_QT_TRANSLATIONS": os.path.join(p, qt, "translations"), "PDAL_DRIVER_PATH": os.path.join(p, "apps", "pdal", "plugins"), "PROJ_LIB": os.path.join(p, "share", "proj"), "PYTHONUTF8": "1", "QGIS_PREFIX_PATH": os.path.join(p, qgis), "QT_PLUGIN_PATH": os.pathsep.join((os.path.join(p, qgis, "qtplugins"), os.path.join(p, qt, "plugins"))), "SSL_CERT_DIR": os.path.join(p, "apps", "openssl", "certs"), "SSL_CERT_FILE": os.path.join(p, "bin", "curl-ca-bundle.crt"), "VSI_CACHE": "TRUE", "VSI_CACHE_SIZE": "1000000"})

# Configurar PATH
import os, sys; os.environ["PATH"] = os.pathsep.join(dict.fromkeys(os.path.normcase(os.path.normpath(path)) for path in ([os.path.join(prefix, dir) for prefix, dir in ((os.environ["QGIS_PREFIX_PATH"], "bin"), (os.environ["GISBASE"], "lib"), (os.environ["GISBASE"], "bin"), (os.environ["O4W_QT_PREFIX"], "bin"), (sys.base_prefix, "Scripts"), (os.environ["OSGEO4W_ROOT"], "bin"))] + os.environ["PATH"].split(os.pathsep))))

# Adicionar diretórios de DLL explicitamente (necessário desde o Python 3.8)
import os; [os.add_dll_directory(path) for path in os.environ["PATH"].split(os.pathsep) if path.startswith(os.environ["OSGEO4W_ROOT"]) and os.path.basename(path) in {"bin", "lib"}]

# Configurar sys.path
import os, sys; sys.path = list(dict.fromkeys(os.path.normcase(os.path.normpath(path)) for path in ([os.path.join(os.environ["QGIS_PREFIX_PATH"], "python"), sys.base_prefix, os.path.join(sys.base_prefix, "Scripts")] + sys.path)))
