{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Copiar diretório de trabalho para o diretório de plugins do QGIS",
      "type": "shell",
      "windows": {
        "command": "${workspaceFolder}\\scripts\\deploy_qgis.bat",
        "options": {
          "cwd": "${workspaceFolder}\\scripts"
        }
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Criar ambiente virtual no workspace usando o Python do QGIS",
      "type": "shell",
      "windows": {
        "command": "${workspaceFolder}\\scripts\\create_venv.bat"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      // "args": [
      //   "${input:venvDir}"
      // ],
      "problemMatcher": []
    },
    {
      "label": "Atualizar dependências de desenvolvimento no ambiente local",
      "type": "shell",
      "windows": {
        "command": "${workspaceFolder}\\scripts\\atualiza_pacotes.bat"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      // "args": [
      //   "${input:venvDir}"
      // ],
      "problemMatcher": []
    }
  ]
}
