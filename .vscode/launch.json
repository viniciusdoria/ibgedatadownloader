// https://gispo.fi/en/blog/cooking-with-gispo-qgis-plugin-development-in-vs-code/
{
  "version": "0.2.0",
  "configurations": [
    {
      // Attaching to the debugging server running on QGIS side.
      "name": "Python: Remote Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/ibgedatadownloader",
          "remoteRoot": "${env:AppData}/QGIS/QGIS3/profiles/default/python/plugins/ibgedatadownloader"
        }
      ],
      "justMyCode": false,
    },
    {
      // Make sure that tests can be debugged in VS Code even if using testing coverage.
      "name": "Debug Tests",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTEST_ADDOPTS": "--no-cov"
      }
    }
  ]
}
